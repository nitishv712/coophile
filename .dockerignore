# Secrets must never enter the build context — anything copied in is readable
# in the image layers forever, even if a later step deletes it.
.env
.env.*
!.env.example

# Build output and caches, rebuilt inside the image.
node_modules
.next
out
build
dist

# Version control and editor state.
.git
.gitignore
.vscode
.idea

# Local scratch that would only invalidate layers.
*.log
npm-debug.log*
.DS_Store
coverage
.claude
